# Copiar a .env para correr en local. NUNCA commitear el .env real.
# En GitHub Actions estos valores van como Secrets del repositorio.

# --- Clash of Clans -----------------------------------------------------
# Llave creada en https://developer.clashofclans.com whitelisteando la IP
# del proxy de RoyaleAPI: 45.79.218.79
COC_TOKEN=

# Proxy que resuelve el whitelist de IP desde hosts sin IP fija.
# Si algun dia corres con IP fija propia, cambiar a https://api.clashofclans.com/v1
COC_BASE_URL=https://cocproxy.royaleapi.dev/v1

# Los clanes, formato "#TAG:ESCUADRA" separados por coma.
# ENTRE COMILLAS: sin ellas el # del primer tag se lee como comentario y el
# valor llega vacio. En GitHub Secrets van SIN comillas.
CLAN_TAGS="#2GC:A,#2CCJYG2YL:B,#228QU9Q8:C,#JUYP2PL:D,#2Q0P0P2JU:E"

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role: salta RLS. Solo en servidor y en GitHub Secrets. Jamas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (alertas a los 3 lideres) ---------------------------------
# Token de @BotFather. chat_id del grupo desde:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp (Baileys, no oficial) -------------------------------------
# Numero SECUNDARIO, solo digitos con codigo de pais. Ej: 5355512345
# NUNCA el numero personal: Baileys viola los terminos y puede ser baneado.
WA_NUMERO=

# JID del grupo del clan. Lo devuelve `npm run wa:vincular`.
WA_GRUPO_JID=

# Umbrales de aviso antes del cierre de la ronda, en horas.
ALERTA_UMBRALES=6,3,1

# Bot de RECLUTAR (el del @usuario corto, para la descripcion del clan).
# Aqui hacen falta solo para registrar su webhook: BOT=recluta npm run tg:webhook
RECLUTA_BOT_TOKEN=
RECLUTA_SECRET_TOKEN=
