NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave ANON, no la service_role. Con RLS activo es seguro que viva en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bot de Telegram (webhook servido por esta misma app) ---------------
# Estas NO llevan NEXT_PUBLIC_: solo viven en el servidor de Vercel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram reenvia en cada peticion. Generalo con:
#   node -e "console.log(crypto.randomUUID())"
TELEGRAM_SECRET_TOKEN=
# Chats autorizados, separados por coma. Sin esto cualquiera consulta el clan.
TELEGRAM_CHAT_ID=
