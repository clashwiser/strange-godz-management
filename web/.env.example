NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave ANON, no la service_role. Con RLS activo es seguro que viva en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bot de Telegram (webhook servido por esta misma app) ---------------
# Estas NO llevan NEXT_PUBLIC_: solo viven en el servidor de Vercel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram reenvia en cada peticion. Generalo con:
#   node -e "console.log(crypto.randomUUID())"
TELEGRAM_SECRET_TOKEN=
# Chats autorizados, separados por coma. Sin esto cualquiera consulta el clan.
TELEGRAM_CHAT_ID=

# Llave de Clash of Clans, para leer el perfil de quien pide entrar.
# Es la MISMA que usan los jobs (esta en el .env de la raiz). Sin ella el
# bot sigue recogiendo solicitudes, pero llegan sin ficha y el lider tiene
# que buscar el tag a mano.
#
# Funciona desde Vercel porque va por el proxy de RoyaleAPI: la llave se
# crea whitelisteando 45.79.218.79 y las IP de Vercel cambian solas.
COC_TOKEN=
COC_BASE_URL=https://cocproxy.royaleapi.dev/v1

# El bot de RECLUTAR: otro bot con @usuario corto, que es el que va en la
# descripcion del clan. Solo recibe solicitudes de ingreso; nada mas pasa
# por el. Se crea en BotFather y se registra su webhook con
#   BOT=recluta WEBHOOK_URL=https://tu-app.vercel.app/api/recluta npm run tg:webhook
RECLUTA_BOT_TOKEN=
RECLUTA_SECRET_TOKEN=

# IA de respaldo para la charla de los bots. Gratis: nivel "Free of charge"
# de la API de Gemini, sin tarjeta. Se crea en aistudio.google.com/apikey.
# Sin ella los bots contestan solo con sus frases; con ella, lo que las
# frases no saben lo contesta la IA, con tope diario propio (IA_TOPE_DIA).
# Motor 1, Gemini. OJO: a nuestro proyecto Google le contesto "Your project
# has been denied access" y pedia facturacion; no lo usamos.
GEMINI_API_KEY=
# Motor 2 (el que esta en produccion): cualquier proveedor con formato
# OpenAI. Groq tiene plan gratis sin tarjeta; Mistral y OpenRouter tambien
# sirven cambiando IA_URL e IA_MODELO. Con IA_LLAVE puesta, manda este motor.
IA_LLAVE=
IA_URL=https://api.groq.com/openai/v1
IA_MODELO=openai/gpt-oss-120b
# El que busca en la web para las preguntas del juego (opcional).
IA_MODELO_BUSCA=groq/compound-mini
IA_TOPE_DIA=300
